<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.averonlabs.eshopverse.core.ui.view.QuantityStepperView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.averonlabs.eshopverse.core.ui.view.PriceTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$12.34" />

    <com.averonlabs.eshopverse.core.ui.view.StateContainerView
        android:layout_width="match_parent"
        android:layout_height="120dp" />

    <com.averonlabs.eshopverse.core.ui.view.StatusBadgeView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delivered" />

</LinearLayout>
