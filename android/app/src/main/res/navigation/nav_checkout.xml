<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_checkout"
    app:startDestination="@id/checkoutPlaceholderFragment">

    <argument
        android:name="shippingAddressId"
        android:defaultValue="@null"
        app:argType="string"
        app:nullable="true" />

    <fragment
        android:id="@+id/checkoutPlaceholderFragment"
        android:name="com.averonlabs.eshopverse.shell.PlaceholderFragment"
        android:label="@string/cart_title"
        tools:layout="@layout/fragment_placeholder" />

</navigation>
