<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_xxl">

    <!-- Drag Handle Indicator -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/avatar_picker_title" />

    <!-- Sheet Title -->
    <TextView
        android:id="@+id/tv_avatar_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:text="@string/avatar_picker_title"
        android:textAppearance="@style/TextAppearance.EShopVerse.SectionTitle"
        android:textColor="@color/text_primary_ink" />

    <!-- Option 1: Take Photo -->
    <LinearLayout
        android:id="@+id/btn_take_photo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/spacing_md"
            android:contentDescription="@null"
            android:src="@drawable/ic_camera"
            app:tint="@color/color_botanical_green" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/avatar_action_take_photo"
            android:textAppearance="@style/TextAppearance.EShopVerse.Body"
            android:textColor="@color/text_primary_ink" />
    </LinearLayout>

    <!-- Option 2: Choose from Gallery -->
    <LinearLayout
        android:id="@+id/btn_choose_gallery"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/spacing_md"
            android:contentDescription="@null"
            android:src="@drawable/ic_photo_library"
            app:tint="@color/color_botanical_green" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/avatar_action_choose_gallery"
            android:textAppearance="@style/TextAppearance.EShopVerse.Body"
            android:textColor="@color/text_primary_ink" />
    </LinearLayout>

    <!-- Option 3: Remove Current Photo -->
    <LinearLayout
        android:id="@+id/btn_remove_photo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="@dimen/spacing_md"
            android:contentDescription="@null"
            android:src="@drawable/ic_delete"
            app:tint="@color/color_terracotta" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/avatar_action_remove"
            android:textAppearance="@style/TextAppearance.EShopVerse.Body"
            android:textColor="@color/color_terracotta" />
    </LinearLayout>

</LinearLayout>
